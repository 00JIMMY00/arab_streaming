   "label": "Last Requested Connection",
   "read_only": 1
  },
  {
   "fieldname": "last_successful_connection",
   "fieldtype": "Datetime",
   "label": "Last Successful Connection",
   "read_only": 1
  },
  {
   "fieldname": "last_connection_exception",
   "fieldtype": "Code",
   "label": "Last Connection Exception",
   "options": "JSON",
   "read_only": 1
  },
  {
   "fieldname": "last_capture_exception",
   "fieldtype": "Code",
   "label": "Last Capture Exception",
   "options": "JSON",
   "read_only": 1
  },
  {
   "fieldname": "last_dispatch_exception",
   "fieldtype": "Code",
   "label": "Last Dispatch Exception",
   "options": "JSON",
   "read_only": 1
  },
  {
   "fieldname": "advanced_tab",
   "fieldtype": "Tab Break",
   "label": "Advanced"
  },
  {
   "fieldname": "receiving_doctypes_data",
   "fieldtype": "Code",
   "label": "Rules received from master (diagnostics)",
   "options": "JSON",
   "read_only": 1,
   "description": "Read-only information refreshed by Ping. Configure master \u2192 slave rules on the master Slave Instance."
  },
  {
   "fieldname": "streaming_rules_summary",
   "fieldtype": "HTML"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 0,
   "email": 0,
   "export": 0,
   "share": 0
  }
 ],
