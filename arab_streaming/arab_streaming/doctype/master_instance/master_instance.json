 "issingle": 0,
 "track_changes": 1,
 "allow_rename": 0,
 "field_order": [
  "connection_tab",
  "connection_summary",
  "connection_status",
  "syncing_status",
  "progress",
  "summary_column",
  "enabled",
  "restaurant_branch",
  "slave_name",
  "connection_details",
  "domain",
  "site_domain",
  "execution_user",
  "credentials_section",
  "access_key",
  "secret",
  "initial_copy_tab",
  "total_syncing_document",
  "exceptions",
  "initial_sync_doctypes",
  "ongoing_tab",
  "streaming_rules_summary",
  "syncing_doctypes",
  "health_tab",
  "last_requested_connection",
  "last_successful_connection",
